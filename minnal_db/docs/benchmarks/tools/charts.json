        "^merge_(counter|sorted_set)_(\\w+)$",
        "merge/\\1/\\2"
      ],
      [
        "^get_then_put_sorted_set_(\\w+)$",
        "get_then_put/sorted_set/\\1"
      ]
    ]
  },
