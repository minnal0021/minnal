      [
        "^scan_range/\\w+_result_count/",
        ""
      ],
      [
        "(\\d+)000$",
        "\\1k"
      ],
      [
        "$",
        "/results"
      ]
    ]
  },
  {
    "file": "scan_cursor.png",
    "title": "One page of a cursor-paginated scan, by page size",
    "ylabel": "Mean latency, µs",
    "unit": "us",
    "scale": "linear",
    "zero_based": true,
    "cases": [
