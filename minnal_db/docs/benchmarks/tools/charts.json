[
  {
    "file": "write.png",
    "title": "Durable write (put), by value size",
    "ylabel": "Mean latency, ms",
    "unit": "ms",
    "scale": "linear",
    "zero_based": true,
    "cases": [
      "write_put/.*"
    ],
    "relabel": [
      [
        "^write_put/value_size/",
        ""
      ],
      [
        "^128B$",
        "128 B value"
      ],
      [
        "^4096B$",
        "4 KiB value"
      ],
      [
        "^65536B$",
        "64 KiB value"
      ]
    ]
  },
  {
    "file": "read.png",
    "title": "Point read (get), in memory against on disk",
    "ylabel": "Mean latency, µs",
    "unit": "us",
    "scale": "linear",
    "zero_based": true,
    "cases": [
      "read_get/.*",
      "read_get_miss/.*"
    ],
    "group_by": "(\\d+B$|miss)",
    "color_by": "(memtable|l1)",
    "legend": {
      "memtable": "in memory",
      "l1": "on disk"
    },
    "relabel": [
      [
        "^read_get/\\w+_value_size/",
        ""
      ],
      [
        "^read_get_miss/\\w+$",
        "key not/found"
      ],
      [
        "^128B$",
        "128 B/value"
      ],
      [
        "^4096B$",
        "4 KiB/value"
      ],
      [
        "^65536B$",
        "64 KiB/value"
      ]
    ]
  },
  {
    "file": "lookup_hits.png",
    "title": "Reading a key that exists, as the store grows",
    "ylabel": "Mean latency, µs",
    "unit": "us",
    "scale": "linear",
    "zero_based": true,
    "cases": [
      "sstable_lookup/.*_hit/.*"
    ],
    "group_by": "/(memtable|l1|mixed)_",
    "legend": {
      "memtable": "in memory",
      "l1": "on disk",
      "mixed": "alternating memory / disk"
    },
    "relabel": [
      [
        "^sstable_lookup/\\w+_hit/",
        ""
      ],
      [
        "(\\d+)000$",
        "\\1k"
      ],
      [
        "$",
        "/keys"
      ]
    ]
  },
  {
    "file": "lookup_misses.png",
    "title": "Reading a key that does not exist, as the store grows",
    "ylabel": "Mean latency, µs",
    "unit": "us",
    "scale": "linear",
    "zero_based": true,
    "cases": [
      "sstable_lookup/.*_miss/.*"
    ],
    "group_by": "/(memtable|l1|mixed)_",
    "legend": {
      "memtable": "in memory",
      "l1": "on disk",
      "mixed": "alternating memory / disk"
    },
    "relabel": [
      [
        "^sstable_lookup/\\w+_miss/",
        ""
      ],
      [
        "(\\d+)000$",
        "\\1k"
      ],
      [
        "$",
        "/keys"
      ]
    ]
  },
  {
    "file": "scan_prefix.png",
    "title": "Prefix scan, by number of matching keys",
    "ylabel": "Mean latency, µs (log scale)",
    "unit": "us",
    "scale": "log",
    "cases": [
      "scan_prefix/.*_128B"
    ],
    "group_by": "_(\\d+)_keys",
    "color_by": "/(memtable|l1)_",
    "legend": {
      "memtable": "in memory",
      "l1": "on disk"
    },
    "relabel": [
      [
        "^scan_prefix/\\w+?_(\\d+)_keys_128B$",
        "\\1"
      ],
      [
        "(\\d+)000$",
        "\\1k"
      ],
      [
        "$",
        "/keys"
      ]
    ]
  },
  {
    "file": "scan_range.png",
    "title": "Range scan, by number of results",
