  {
    "file": "scan_iter.png",
    "title": "Reading all 2,000 keys with their values",
    "ylabel": "Mean latency, ms",
    "unit": "ms",
    "scale": "linear",
    "zero_based": true,
    "cases": [
      "scan_iter/.*"
    ],
    "group_by": "/(\\d+B)$",
    "color_by": "/(memtable|l1)_",
    "legend": {
      "memtable": "in memory",
      "l1": "on disk"
    },
    "relabel": [
      [
        "^scan_iter/\\w+_value_size/",
        ""
      ],
      [
        "^128B$",
        "128 B/values"
      ],
      [
        "^4096B$",
        "4 KiB/values"
      ]
    ]
  },
  {
    "file": "wal_fsync.png",
    "title": "One write-ahead log append, with and without the fsync",
    "ylabel": "Mean latency, µs (log scale)",
    "unit": "us",
    "scale": "log",
    "cases": [
      "wal_append_fsync/.*",
      "wal_append_no_fsync/.*"
    ],
    "group_by": "/(\\d+B)$",
    "color_by": "^wal_append_(fsync|no_fsync)/",
    "legend": {
      "fsync": "synced to disk (every real write)",
      "no_fsync": "not synced (for comparison)"
    },
    "relabel": [
      [
        "^wal_append_\\w+/value_size/",
        ""
      ],
      [
        "^128B$",
        "128 B/value"
      ],
      [
        "^4096B$",
        "4 KiB/value"
      ],
      [
        "^65536B$",
        "64 KiB/value"
      ]
    ]
  },
  {
    "file": "predicate.png",
    "title": "Field-index query over 100,000 rows, by query",
    "ylabel": "Mean latency, µs (log scale)",
    "unit": "us",
    "scale": "log",
    "cases": [
      "predicate_str_eq",
      "predicate_compound_and",
      "predicate_compound_or",
      "predicate_int_range",
      "predicate_three_way_and",
      "predicate_selectivity/AND/6pct"
    ],
    "color_by": {
      "range": "int_range|three_way_and|6pct",
      "equality": "."
    },
    "legend": {
      "equality": "equality tests only",
      "range": "includes an age range"
    },
    "relabel": [
      [
        "^predicate_str_eq$",
        "status = a"
      ],
      [
        "^predicate_compound_and$",
        "status = a/AND active"
      ],
      [
        "^predicate_compound_or$",
        "status = a/OR status = b"
      ],
      [
        "^predicate_int_range$",
        "age 30-50"
      ],
      [
        "^predicate_three_way_and$",
        "status = a/AND active/AND age >= 25"
      ],
      [
        "^predicate_selectivity/AND/6pct$",
        "status = a/AND active/AND age >= 50"
      ]
    ]
  },
  {
    "file": "semantic_search.png",
    "title": "Semantic search over 5,000 documents, by chunks per document",
    "ylabel": "Mean latency, ms",
    "unit": "ms",
    "scale": "linear",
    "zero_based": true,
    "cases": [
      "end_to_end_multichunk/.*"
    ],
    "relabel": [
      [
        "^end_to_end_multichunk/chunks_per_doc/1$",
        "1 chunk/per document"
      ],
      [
        "^end_to_end_multichunk/chunks_per_doc/(\\d+)$",
        "\\1 chunks/per document"
      ]
    ]
  }
]